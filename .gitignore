# dependencies
node_modules/

# frontend build / tooling caches
web/dist/
web/.vite/
*.tsbuildinfo
web/coverage/

# runtime scratch: warehouse, snapshots, logs, screenshots, build products
.cache/

# built binaries
/tokanary
/tokanary.exe
/tokanary-desktop
/tokanary-desktop.exe
# Windows cannot overwrite a running .exe, so `go build -o tokanary-desktop.exe .`
# parks the old image next to it instead of replacing it.
/tokanary-desktop.exe~

# release packages: two ~14MB binaries plus a checksum file
dist-tokanary-*/

# analysis store (rebuildable)
*.sqlite
*.sqlite-wal
*.sqlite-shm

# local env / secrets
.env
.env.*

# OS junk
.DS_Store

# agent tooling artifacts
.vidt/
.agent-memory/
