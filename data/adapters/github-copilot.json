{
  "id": "github-copilot",
  "label": "GitHub Copilot",
  "kind": "jsonl",
  "paths": [
    "{home}/.copilot/session-state/**/*.jsonl",
    "{home}/.config/github-copilot/**/*.jsonl"
  ],
  "prefilter": [
    "\"usage\"",
    "tokens",
    "completion_tokens"
  ],
  "require": [],
  "dedup": [
    "id",
    "requestId",
    "$file#$line"
  ],
  "fields": {
    "model": [
      "model",
      "model_id"
    ],
    "session": [
      "session_id",
      "conversationId",
      "$dir"
    ],
    "time": [
      "timestamp",
      "created_at"
    ],
    "input": [
      "usage.input_tokens",
      "input_tokens",
      "prompt_tokens"
    ],
    "output": [
      "usage.completion_tokens",
      "output_tokens",
      "completion_tokens"
    ],
    "cacheRead": [
      "usage.cache_read_input_tokens",
      "cached_tokens"
    ],
    "reasoning": [
      "usage.completion_tokens_details.reasoning_tokens"
    ]
  },
  "caveat": "CodeBurn 注释：~/.copilot/session-state 只记 output，input/cache 多半缺失，费用会低估；更全的是 agent-traces.db（需 VS Code 开关）。",
  "note": "JSONL 回退路径。完整计量需 OTel agent-traces.db（后续可加 sqlite 源）。"
}