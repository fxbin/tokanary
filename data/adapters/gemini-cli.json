{
  "id": "gemini-cli",
  "label": "Gemini CLI",
  "kind": "json",
  "json_rows": "messages",
  "paths": [
    "{home}/.gemini/tmp/*/chats/session-*.json",
    "{home}/.gemini/tmp/*/chats/session-*.jsonl"
  ],
  "prefilter": [
    "tokens",
    "usageMetadata",
    "promptTokenCount"
  ],
  "require": [
    "tokens"
  ],
  "dedup": [
    "id",
    "$file#$line"
  ],
  "fields": {
    "model": [
      "model",
      "modelVersion"
    ],
    "session": [
      "sessionId",
      "$dir"
    ],
    "time": [
      "timestamp",
      "startTime"
    ],
    "input": [
      "tokens.input",
      "usageMetadata.promptTokenCount"
    ],
    "output": [
      "tokens.output",
      "usageMetadata.candidatesTokenCount"
    ],
    "cacheRead": [
      "tokens.cached",
      "usageMetadata.cachedContentTokenCount"
    ],
    "reasoning": [
      "tokens.thoughts",
      "usageMetadata.thoughtsTokenCount"
    ]
  },
  "note": "~/.gemini/tmp/*/chats/session-*.json，messages[].tokens {input,output,cached,thoughts}。"
}