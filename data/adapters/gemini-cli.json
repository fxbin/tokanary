{
  "id": "gemini-cli",
  "label": "Gemini CLI",
  "kind": "json",
  "paths": [
    "{home}/.gemini/tmp/**/chats/*.json",
    "{home}/.gemini/**/*.json"
  ],
  "prefilter": ["usageMetadata", "promptTokenCount", "candidatesTokenCount"],
  "require": ["usageMetadata"],
  "where": {},
  "dedup": ["responseId", "$file#$line"],
  "fields": {
    "model": ["modelVersion", "model"],
    "session": ["$dir", "sessionId"],
    "time": ["createTime", "timestamp"],
    "input": ["usageMetadata.promptTokenCount", "usageMetadata.prompt_tokens"],
    "output": ["usageMetadata.candidatesTokenCount", "usageMetadata.completion_tokens"],
    "cacheRead": ["usageMetadata.cachedContentTokenCount", "usageMetadata.cached_tokens"],
    "reasoning": ["usageMetadata.thoughtsTokenCount", "usageMetadata.reasoning_tokens"]
  },
  "note": "Gemini CLI 会话 JSON：usageMetadata 为 Google GenAI 计量；thoughtsTokenCount 若已含在 candidates 内会由 reasoning clamp 防止双计。"
}
