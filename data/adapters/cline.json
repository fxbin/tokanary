{
  "id": "cline",
  "label": "Cline",
  "kind": "json",
  "paths": [
    "{home}/.cline/data/**/*.json",
    "{home}/.cline/data/**/api_conversation_history.json"
  ],
  "prefilter": [
    "cacheReads",
    "inputTokens",
    "prompt_tokens"
  ],
  "require": [],
  "dedup": [
    "id",
    "$file#$line"
  ],
  "fields": {
    "model": [
      "model"
    ],
    "session": [
      "taskId",
      "$dir"
    ],
    "time": [
      "timestamp"
    ],
    "input": [
      "inputTokens",
      "promptTokens"
    ],
    "output": [
      "outputTokens",
      "completionTokens"
    ],
    "cacheRead": [
      "cacheReads"
    ],
    "cacheWrite": [
      "cacheWrites"
    ]
  },
  "note": "对齐 CodeBurn cline.ts：~/.cline/data 任务目录。"
}